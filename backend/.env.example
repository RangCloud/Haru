# 하루(Haru) 백엔드 환경 변수 예시
# 이 파일을 .env로 복사한 뒤 실제 값을 채워 넣으세요.
# .env는 절대 커밋하지 않습니다 (.gitignore에 포함됨).

# ── 기상청 공공데이터포털 API 인증키 ─────────────────────────
# 발급처: https://www.data.go.kr → "기상청_단기예보_조회서비스" 신청
WEATHER_API_KEY=your_kma_api_key_here

# ── 날씨 캐시 TTL (초, 기본 3600 = 1시간) ────────────────────
# 기상청 단기예보는 3시간마다 갱신되므로 1시간 캐시로 충분
WEATHER_CACHE_TTL=3600

# ── CORS 허용 오리진 (개발 중에는 * 그대로 두세요) ────────────
# CORS_ORIGINS=["http://localhost:8081"]

# ── 네이버 오픈 API ───────────────────────────────────────────
# 발급처: https://developers.naver.com → 애플리케이션 등록 → 검색 API 추가
# 무료 할당량: 하루 25,000회 (뉴스 검색)
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# ── Anthropic (Claude) API 키 ─────────────────────────────────
# 발급처: https://console.anthropic.com → API Keys
# 운세 기능에 사용 (claude-haiku-4-5, 하루 캐시로 비용 최소화)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
