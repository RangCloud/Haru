# ── Python / 백엔드 ───────────────────────────────────────────
backend/.venv/
__pycache__/
*.pyc
backend/.env

# ── Node / 프론트엔드 ─────────────────────────────────────────
frontend/node_modules/
frontend/.expo/
frontend/dist/
frontend/web-build/
frontend/expo-env.d.ts

# ── 환경 변수 (민감 정보 — 절대 커밋 금지) ───────────────────
frontend/.env*.local

# ── Expo / EAS 네이티브 파일 ──────────────────────────────────
# bare workflow 전환 후 android/, ios/ 는 커밋 대상.
# 빌드 산출물·개인 설정만 제외.
frontend/android/build/
frontend/android/app/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/ios/build/
frontend/ios/Pods/

# ── 인증서 / 키파일 ──────────────────────────────────────────
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# ── IDE / 에디터 설정 ─────────────────────────────────────────
# Claude Code 프로젝트 설정 — 개인 IDE 설정이므로 저장소 제외
**/.claude/
# Android Studio 프로젝트 설정 — 개인 IDE 설정이므로 저장소 제외
**/.idea/
# VSCode workspace 설정은 팀 공유 목적이면 커밋 가능, 개인 설정이면 제외
# .vscode/

# ── QA / 테스트 산출물 ────────────────────────────────────────
# 로컬 작업용 엑셀은 제외하고, 공개용 QA 문서(docs/qa/)만 저장소에 올림
*.xlsx
!docs/qa/*.xlsx

# ── 기타 ─────────────────────────────────────────────────────
# 초기 파일 압축본 — 저장소에 포함 불필요
files.zip
files/
.DS_Store
*.orig.*
npm-debug.*
yarn-debug.*
yarn-error.*
*.tsbuildinfo
.kotlin/

# ── 개인 메모·시안 (커밋하지 않음) ────────────────────────────
# 진행상황 메모에는 서버 IP·연락처가 있고, 시안 HTML은 2MB 번들이라 저장소에 넣지 않기로 함 (2026-11-18)
하루_앱_개발_진행상황.txt
frontend/하루 UI 리디자인 시안.html
